#!/usr/bin/env bash
# Require the GitHub release tag and Mix package to share VERSION.
set -euo pipefail
[[ $# == 1 ]] || { echo 'Usage: scripts/check-release-version TAG' >&2; exit 64; }
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
tag=$1
version=$(tr -d '[:space:]' < VERSION)
[[ "$tag" == "v$version" ]] || {
  echo "Release tag $tag does not match VERSION ($version)" >&2
  exit 1
}
QLOVER_EXPECTED_VERSION="$version" mix run --no-start --no-compile --no-deps-check -e '
  expected = System.fetch_env!("QLOVER_EXPECTED_VERSION")
  Version.parse!(expected)
  actual = Mix.Project.config()[:version]
  if actual != expected, do: Mix.raise("Mix version #{actual} does not match VERSION (#{expected})")
'
